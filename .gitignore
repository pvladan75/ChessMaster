# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.env
*.env
node_modules/
chess_backend/node_modules/
chess_backend/exports/*.mp4

# Uploaded lesson audio. These are recordings of real lessons — user data, and
# on this project often children's voices. They must never enter the repository.
chess_backend/uploads/

# Gradle build output. chess_app/.gitignore covers /build/ but not this one.
chess_app/android/build/
chess_app/android/.gradle/

# Local agent configuration
.claude/
puzzles/*.zst
puzzles/*.csv
puzzles/*.json

# Python bytecode from the puzzle tooling
__pycache__/
*.pyc

# Sastavljeni dizajn kanvas — 2,2 MB, regeneriše se iz .dc.html radnih fajlova
design/*/*.html
!design/*/*.dc.html

# Scratch list of bugs found while walking through the app. It carries pasted
# logs, and a log carries whatever the machine was talking to at the time —
# LAN addresses, ports, sometimes an address book. The repository is public, so
# this one stays on the machine that writes it.
docs/bug_spec.txt

# Antigravity CLI drops a symlink to its per-project config here.
.antigravitycli/

# QA working files: findings live in the test log outside this repo, never in it.
.answers.txt
.findings.txt
