# Database Credentials
DB_USER=doadmin
DB_PASSWORD=your_database_password_here
DB_HOST=your_database_host_here.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=defaultdb
DB_SSL=true

# Server Configuration
PORT=3000
# Set to "production" to disable the debug puzzle-log endpoint and dev-only mail fallback
NODE_ENV=development
LOG_LEVEL=info

# Security Secrets (Generated with high-entropy random keys)
# REQUIRED: the server refuses to start without this.
# Generate a new key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated browser origins allowed to call the API (CORS).
# Native Android/Windows clients send no Origin header and are always allowed,
# so this only matters for Flutter Web builds.
ALLOWED_ORIGINS=http://localhost:8080,https://app.example.com

# Google Sign-In: OAuth client IDs this server accepts ID tokens for.
# REQUIRED for Google login. Comma-separated to support web + Android + iOS clients.
GOOGLE_CLIENT_IDS=425483567970-jgkipp2dfqmc40kvacn2aginpjnph28s.apps.googleusercontent.com

# SMTP for verification emails. Without these, codes are only printed to the log in
# development and registration fails outright when NODE_ENV=production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=Chess Master <no-reply@chessmaster.app>

# Agora voice chat. Enable the App Certificate in the Agora console — without it,
# anyone holding the App ID can join any lesson's voice channel.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN_TTL_SECONDS=3600

# External API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# How many days a rendered MP4 export stays on disk before automatic cleanup
# deletes it. Exports are always reproducible from the underlying recording, so
# they age out; the recording's audio in uploads/ never does. Runs on startup
# and every 24h.
EXPORT_RETENTION_DAYS=14

# Tier limits (set to "true" to enforce free-plan quotas)
# Keep this false until purchasing works end to end — with it on and no way to
# buy, free accounts hit the session cap with no way out.
ENABLE_LIMITS=false

# ---------------------------------------------------------------------------
# Google Play Billing
# ---------------------------------------------------------------------------
# Play is the merchant of record: it charges the customer, handles VAT, and pays
# out to the developer's bank account. Serbia is a merchant-supported location,
# so an individual developer can sell subscriptions without a company.
#
# Leave these blank and the app still runs — /billing/config reports that
# purchasing is unavailable, the app hides the buy button, and tiers can still be
# granted manually by an admin via POST /users/account-type.

# The application id the products live under, e.g. com.example.chess_app
GOOGLE_PLAY_PACKAGE_NAME=

# Service account with the "View financial data" and "Manage orders and
# subscriptions" permissions in Play Console, granted access to this app.
GOOGLE_PLAY_SA_EMAIL=play-billing@your-project.iam.gserviceaccount.com
# The private_key field from the service account JSON. Keep the \n escapes —
# they are expanded at load time, since .env cannot hold real newlines.
GOOGLE_PLAY_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Which Play product grants which tier. A product missing from this map grants
# nothing, so add the entry before activating a new price point in Play Console.
PLAY_PRODUCT_TIERS={"coach_pro_monthly":"premium","coach_pro_yearly":"premium","club_monthly":"club"}

# Shared secret appended to the Real-Time Developer Notifications push endpoint:
#   https://your-host/billing/play/rtdn?key=THIS_VALUE
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAY_RTDN_SECRET=

# ---------------------------------------------------------------------------
# Cost metering
# ---------------------------------------------------------------------------
# What one unit of each metered resource costs you, used by GET /billing/usage
# to estimate what serving each user costs per month. Any currency — the report
# only multiplies. Leave unset and usage is still recorded, with costs as zero.
#
# Fill these from your actual provider invoices, not from list prices:
#   agora_seconds       — Agora voice, per second (their per-minute rate / 60)
#   mp4_render_seconds  — server CPU per second of rendered video
#   ai_comments         — average Gemini cost per generated comment
#   mp4_renders         — any flat per-job cost (storage, egress)
USAGE_UNIT_COSTS={"agora_seconds":0.0000165,"mp4_render_seconds":0.0004,"ai_comments":0.002,"mp4_renders":0.01}
