# Database Credentials
DB_USER=doadmin
DB_PASSWORD=your_database_password_here
# On a droplet in the same VPC as the cluster, use the private host from the
# control panel (Overview -> Connection details -> VPC network). It resolves
# inside the VPC only, so the traffic never reaches the public internet.
DB_HOST=your_database_host_here.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=defaultdb

# TLS to the database, in order of preference:
#
#   DB_CA_PATH  path to the cluster's CA certificate ("Download CA certificate"
#               on the same panel). Verifies the certificate chain and the
#               hostname — what DigitalOcean calls verify-full, and the only
#               setting under which encryption also proves who answered. A path
#               that does not resolve stops the server rather than downgrading.
#   DB_SSL=true encrypted but unverified. Superseded by DB_CA_PATH when both are
#               set; on its own, open to an active man in the middle.
#
# Set neither for a local PostgreSQL without TLS.
DB_CA_PATH=
DB_SSL=true

# Server Configuration
PORT=3000
# Set to "production" to disable the debug puzzle-log endpoint and dev-only mail fallback
NODE_ENV=development
LOG_LEVEL=info

# Security Secrets (Generated with high-entropy random keys)
# REQUIRED: the server refuses to start without this.
# Generate a new key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated browser origins allowed to call the API (CORS).
# Native Android/Windows clients send no Origin header and are always allowed,
# so this only matters for Flutter Web builds.
ALLOWED_ORIGINS=http://localhost:8080,https://app.example.com

# Google Sign-In: OAuth client IDs this server accepts ID tokens for.
# REQUIRED for Google login. Comma-separated to support web + Android + iOS clients.
# The Windows build signs in through its own "Desktop app" OAuth client (the
# google_sign_in plugin does not support Windows at all), and that client mints
# tokens with its own `aud` - so its id has to be in this list too, or every
# desktop sign-in is refused with "Google token nije izdat za ovu aplikaciju".
GOOGLE_CLIENT_IDS=425483567970-jgkipp2dfqmc40kvacn2aginpjnph28s.apps.googleusercontent.com

# SMTP for verification emails. Without these, codes are only printed to the log in
# development and registration fails outright when NODE_ENV=production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=Chess Coach <no-reply@chesstrainers.app>

# Agora voice chat. Enable the App Certificate in the Agora console — without it,
# anyone holding the App ID can join any lesson's voice channel.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN_TTL_SECONDS=3600

# External API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# How many days a rendered MP4 export stays on disk before automatic cleanup
# deletes it. Exports are always reproducible from the underlying recording, so
# they age out; the recording's audio in uploads/ never does. Runs on startup
# and every 24h.
EXPORT_RETENTION_DAYS=14

# Tier limits (set to "true" to enforce free-plan quotas)
# Keep this false until purchasing works end to end — with it on and no way to
# buy, free accounts hit the session cap with no way out.
ENABLE_LIMITS=false

# ---------------------------------------------------------------------------
# Age of consent
# ---------------------------------------------------------------------------
# Below this age the user is treated as a minor: they can be somebody's student
# but never somebody's trainer, so the app is not a place where children connect
# to each other.
#
# It is configuration because the number is a per-country decision. Under the
# GDPR it runs from 13 to 16 and never higher — 18 would add friction without
# legal benefit — and Serbia, the only country this ships to today, sits at 15.
# 16 covers it and is the default when this is left unset.
#
# A value outside 13–18 stops the server rather than falling back to the
# default: a threshold that quietly reverts is a rule about children that
# quietly stops applying.
AGE_OF_CONSENT=16

# ---------------------------------------------------------------------------
# Parental consent
# ---------------------------------------------------------------------------
# Where this server is reachable from the outside, without a trailing slash.
# It is used to build the link a parent opens (`<base>/consent/<token>`), and
# nothing else.
#
# Leave it empty and the flow does not silently do nothing: a relationship with
# a minor still stops at "awaiting_parent", and the API says the letter could
# not be sent. What it must never be is half a value — a base that is not an
# absolute http(s) origin stops the server, because a broken link is discovered
# only by a parent who has already decided the app does not work.
#
# Note that this is the **public** address, which is not the LAN address the
# app talks to while the backend runs at home. A parent's phone is not on that
# network.
PUBLIC_BASE_URL=

# Which version of the consent text a parent agreed to. Written into
# `parent_consent_version` on both the account and the relationship.
#
# The country is part of the identifier because the same product will need
# different text elsewhere: a lawyer confirmed this wording on 25.8.2026 for
# Serbia only, and said so explicitly. A record that cannot say which text was
# read is not a record. Letters, digits, dot, dash and underscore, up to 40
# characters; anything else stops the server.
PARENT_CONSENT_VERSION=rs-2026-08-26

# ---------------------------------------------------------------------------
# Google Play Billing
# ---------------------------------------------------------------------------
# Play is the merchant of record: it charges the customer, handles VAT, and pays
# out to the developer's bank account. Serbia is a merchant-supported location,
# so an individual developer can sell subscriptions without a company.
#
# Leave these blank and the app still runs — /billing/config reports that
# purchasing is unavailable, the app hides the buy button, and tiers can still be
# granted manually by an admin via POST /users/account-type.

# The application id the products live under, e.g. com.example.chess_app
GOOGLE_PLAY_PACKAGE_NAME=

# Service account with the "View financial data" and "Manage orders and
# subscriptions" permissions in Play Console, granted access to this app.
GOOGLE_PLAY_SA_EMAIL=play-billing@your-project.iam.gserviceaccount.com
# The private_key field from the service account JSON. Keep the \n escapes —
# they are expanded at load time, since .env cannot hold real newlines.
GOOGLE_PLAY_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Which Play product grants which tier. A product missing from this map grants
# nothing, so add the entry before activating a new price point in Play Console.
PLAY_PRODUCT_TIERS={"coach_pro_monthly":"premium","coach_pro_yearly":"premium","club_monthly":"club"}

# Shared secret appended to the Real-Time Developer Notifications push endpoint:
#   https://your-host/billing/play/rtdn?key=THIS_VALUE
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAY_RTDN_SECRET=

# ---------------------------------------------------------------------------
# Cost metering
# ---------------------------------------------------------------------------
# What one unit of each metered resource costs you, used by GET /billing/usage
# to estimate what serving each user costs per month. Any currency — the report
# only multiplies. Leave unset and usage is still recorded, with costs as zero.
#
# Fill these from your actual provider invoices, not from list prices:
#   agora_seconds       — Agora voice, per second (their per-minute rate / 60)
#   mp4_render_seconds  — server CPU per second of rendered video
#   ai_comments         — average Gemini cost per generated comment
#   mp4_renders         — any flat per-job cost (storage, egress)
USAGE_UNIT_COSTS={"agora_seconds":0.0000165,"mp4_render_seconds":0.0004,"ai_comments":0.002,"mp4_renders":0.01}

# ---------------------------------------------------------------------------
# Endgame tablebase
# ---------------------------------------------------------------------------
# Where the play-it-out drill asks whether a move held the result. Node has no
# Syzygy reader and the droplet has 960 MB of RAM, so the tables are reached
# over the network rather than held locally; the server asks, never the app,
# because a verdict that arrives from a client is one the server cannot check.
# Leave unset to use the public Lichess endpoint. Point it at your own
# lila-tablebase if you ever run one - nothing else has to change.
LICHESS_TABLEBASE_URL=https://tablebase.lichess.ovh/standard

# ---------------------------------------------------------------------------
# Opening database (Lichess Explorer)
# ---------------------------------------------------------------------------
# The Explorer requires a token, so the server holds one for everybody instead
# of every user creating their own and pasting it into Settings - a step most of
# them never took, which left the panel silently falling back to ChessDB.
#
# Create it at https://lichess.org/account/oauth/token/create with NO scopes
# ticked: the token only identifies who is asking, so the request counter has a
# name. Anything more is a permission on that account we do not need and would
# not want to keep in a .env.
#
# Leave it unset and nothing breaks - GET /opening-explorer answers 503 with
# reason "not-configured" and the app uses ChessDB.
LICHESS_API_TOKEN=

# Where to ask. Leave unset for the public Lichess Explorer.
LICHESS_EXPLORER_URL=https://explorer.lichess.ovh/lichess

# Where the archive importer reads a player's games from. Overridden only by a
# test or a mirror; the token above is optional here - this endpoint serves any
# account to anyone, and the token only raises how fast the stream arrives.
LICHESS_GAMES_URL=https://lichess.org/api/games/user

# ---------------------------------------------------------------------------
# Judging one opening move (GET /opening-judge)
# ---------------------------------------------------------------------------
# The judge answers "theory, playable, or a mistake?" for a single move. It
# spends **the caller's own** Lichess token, sent per request in a header and
# never stored here: judging costs up to four upstream questions per move, and
# the shared LICHESS_API_TOKEN above is one allowance for every child in the
# app. A user without a token of their own is told so and judged nothing.
#
# Both URLs below are only for pointing the judge somewhere else - neither is
# needed for it to work.
LICHESS_MASTERS_URL=https://explorer.lichess.ovh/masters
LICHESS_CLOUD_EVAL_URL=https://lichess.org/api/cloud-eval

# ---------------------------------------------------------------------------
# The public site (deploy/site-setup.sh)
# ---------------------------------------------------------------------------
# Values filled into the pages in site/ when they are published. They are here
# rather than in the repository because the repository is public and two of them
# are a private person's name and address — which the privacy policy is
# nevertheless legally required to carry, since somebody has to be nameable as
# the data controller.
#
# site-setup.sh refuses to publish a page that still has a {{PLACEHOLDER}} in
# it: a policy naming nobody is worse than no policy at all.
OPERATOR_NAME=Ime i prezime ili naziv
OPERATOR_ADDRESS=Ulica i broj, Grad
PRIVACY_EMAIL=privatnost@example.com
SUPPORT_EMAIL=podrska@example.com
HOSTING_PROVIDER=DigitalOcean
HOSTING_REGION=Amsterdam, Holandija
SMTP_PROVIDER=SMTP provajder
# The date printed as "Poslednja izmena" on the policy. Deliberately not
# "today": a legal document's date is a decision, and one that moves on every
# deploy is one nobody can rely on.
SITE_LAST_UPDATED=26.8.2026.
